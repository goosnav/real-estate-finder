# Optional environment variables. The app does not automatically load .env files.
# Set these in your shell or process manager. Never commit credentials.
# Leave unset to use the normal OS app-data directory and PATH lookup.
REAL_ESTATE_FINDER_DATA=
REAL_ESTATE_FINDER_CODEX_BIN=
REAL_ESTATE_FINDER_CLAUDE_BIN=

# Sign in with your chosen CLI outside this application.
# Real Estate Finder uses that CLI's existing authentication; it stores no API keys.
